# Run from the repository root: cmake -P tools/package.cmake
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(STAGE "${ROOT}/.package-stage")
file(REMOVE_RECURSE "${STAGE}")
file(GLOB_RECURSE CANDIDATES RELATIVE "${ROOT}" "${ROOT}/*" "${ROOT}/.github/*")
list(SORT CANDIDATES)
set(FILES "")
set(MANIFEST "{\n  \"version\": \"0.4.1\",\n  \"implementation\": \"C++17\",\n  \"files\": {\n")
set(SEP "")
foreach(F IN LISTS CANDIDATES)
  if(F MATCHES "^build[^/]*/" OR F MATCHES "^cmake-build[^/]*/" OR F MATCHES "^runs/" OR F MATCHES "^\\.git/" OR F MATCHES "^\\.package-stage/" OR F MATCHES "(^|/)\\.DS_Store$" OR F MATCHES "\\.(aux|log|toc|out|fls|fdb_latexmk|synctex.gz)$" OR F STREQUAL "PACKAGE_MANIFEST.json")
    continue()
  endif()
  if(IS_DIRECTORY "${ROOT}/${F}")
    continue()
  endif()
  file(SHA256 "${ROOT}/${F}" HASH)
  string(APPEND MANIFEST "${SEP}    \"${F}\": \"${HASH}\"")
  set(SEP ",\n")
  get_filename_component(PARENT "${STAGE}/${F}" DIRECTORY)
  file(MAKE_DIRECTORY "${PARENT}")
  configure_file("${ROOT}/${F}" "${STAGE}/${F}" COPYONLY)
  list(APPEND FILES "${F}")
endforeach()
string(APPEND MANIFEST "\n  }\n}\n")
file(WRITE "${STAGE}/PACKAGE_MANIFEST.json" "${MANIFEST}")
list(APPEND FILES "PACKAGE_MANIFEST.json")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${ROOT}/../quantum-gas-transport-v0.4.1.zip" --format=zip -- ${FILES} WORKING_DIRECTORY "${STAGE}" RESULT_VARIABLE STATUS)
file(REMOVE_RECURSE "${STAGE}")
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Packaging failed: ${STATUS}")
endif()
list(LENGTH FILES COUNT)
message(STATUS "Packaged ${COUNT} files; manifest exists only in the release archive")
